; Engine configuration file.
; Keep Living — Godot 4.4

config_version=5

[application]

config/name="Keep Living"
config/description="A roguelite about surviving the end of the world from inside your Tokyo apartment."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.png"
config/version="0.1.0"
boot_splash/bg_color=Color(0.063, 0.078, 0.133, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/use_custom_user_dir=true
config/custom_user_dir_name="KeepLiving"

[autoload]

Meta="*res://scripts/autoload/meta_progress.gd"
Game="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="barricade"
3d_physics/layer_3="zombie"
3d_physics/layer_4="player"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.05

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3
global_illumination/sdfgi/probe_ray_count=0
global_illumination/sdfgi/frames_to_converge=2
environment/ssao/quality=1
